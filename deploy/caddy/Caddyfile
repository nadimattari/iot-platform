# iiot-platform edge proxy — Caddy with the Mercure module (dunglas/mercure).
#
# The site address is driven by the SERVER_NAME env var (docker-compose derives
# it from DOMAIN): an empty/`:80` value serves plain HTTP for local dev; a real
# domain triggers automatic HTTPS via Let's Encrypt (Caddy auto-TLS).
{$SERVER_NAME:localhost} {
	# Liveness probe for the container healthcheck.
	respond /healthz 200

	# Root redirects to the dashboard so the placeholder is reachable at /
	# without knowing the path.
	redir / /dashboard/

	# Auth API (Node service) — full path preserved.
	handle /auth/* {
		reverse_proxy auth:3000
	}

	# Device management API (Symfony) — full path preserved.
	handle /api/v1/* {
		reverse_proxy device-mgmt:80
	}

	# Ingestion API — HTTP ingest endpoint (Task 11). Full path preserved.
	handle /ingest/* {
		reverse_proxy ingestion:8000
	}

	# Dashboard SPA (Vue 3 + PrimeVue, built into the dashboard container).
	# The prefix is stripped so nginx serves the app at its root; client-side
	# routing falls back to index.html in nginx.
	handle_path /dashboard* {
		reverse_proxy dashboard:80
	}

	# Mercure SSE hub: topic ACLs are enforced via the `publish`/`subscribe`
	# topic-selector claims in publisher/subscriber JWTs (see the hub config).
	import /etc/caddy/mercure/Caddyfile

	# Fallback for unmapped paths.
	respond "Not Found" 404
}

# ChirpStack web UI + API (Task 14). ChirpStack v4 has no sub-path support
# (its UI hard-codes /, /static, /logo, ...), so it gets its own hostname:
# http://chirpstack.localhost in dev, chirpstack.<domain> in production
# (override CHIRPSTACK_SITE_ADDR, e.g. https://chirpstack.example.com).
{$CHIRPSTACK_SITE_ADDR:http://chirpstack.localhost} {
	reverse_proxy chirpstack:8080
}
