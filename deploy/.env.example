# iiot-platform environment configuration
#
# Copy to deploy/.env and fill in real values. deploy/.env is git-ignored —
# never commit real secrets. Required variables are marked (required);
# everything else has a safe default or is consumed by a later task.

# --- Public deployment -------------------------------------------------------
# Public domain used by Caddy for automatic HTTPS (used from Task 8 onward).
DOMAIN=

# --- PostgreSQL --------------------------------------------------------------
# Superuser for the shared PostgreSQL instance. The `iiot` and `chirpstack`
# databases are created by the bootstrap scripts in db/init (Task 2).
POSTGRES_USER=iiot
POSTGRES_PASSWORD=change-me

# --- Redis (ChirpStack dependency) -------------------------------------------
# Optional auth password; left empty for now. If set, it must be enabled in
# the ChirpStack configuration too (Task 14).
REDIS_PASSWORD=

# --- MQTT broker (Mosquitto) -------------------------------------------------
# Broker credentials. Used from Task 7 onward: Mosquitto authenticates every
# client and per-device credentials are provisioned by device-mgmt.
MOSQUITTO_USER=broker
MOSQUITTO_PASSWORD=change-me

# --- Auth service (Node) -----------------------------------------------------
# Admin account seeded on first boot (Task 3-4).
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-me
# Ed25519 signing keys for JWT. If empty, generated once on first boot and
# persisted to the auth_keys volume (Task 3).
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# Token lifetimes (Task 4). Access tokens are signed JWTs; refresh tokens are
# opaque, stored hashed, and rotate on every use.
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_DAYS=30

# --- Device management (Symfony) ----------------------------------------------
# Symfony app secret: any random string, used for session/CSRF security.
APP_SECRET=change-me
# Base URI for URL generation outside HTTP contexts (CLI/workers).
DEFAULT_URI=http://localhost
# URL of the auth service's public JWKS endpoint used to validate JWT access
# tokens (Task 5). Points at the auth container on the backend network.
AUTH_JWKS_URL=http://auth:3000/auth/jwks
# How long the fetched JWKS stays in the device-mgmt cache, in seconds.
AUTH_JWKS_TTL=3600
# Shared Mosquitto credentials file (Task 7). docker-compose sets it to the
# broker's bind mount; leave empty when running without a broker.
MQTT_PASSWD_FILE=

# --- Mercure (SSE hub, hosted inside Caddy) ----------------------------------
# Random strings. Publisher key is used by ingestion/device-mgmt to publish
# events; subscriber key is used by the dashboard to subscribe.
MERCURE_PUBLISHER_JWT_KEY=change-me
MERCURE_SUBSCRIBER_JWT_KEY=change-me

# --- Ingestion service (Python) ----------------------------------------------
# Broker credentials for the ingestion MQTT client (Task 10).
INGESTION_MQTT_USERNAME=ingestion
INGESTION_MQTT_PASSWORD=change-me

# --- ChirpStack (LoRaWAN) ----------------------------------------------------
# ChirpStack uses the shared PostgreSQL (separate `chirpstack` database) and
# Redis. Its MQTT integration uses dedicated broker credentials.
CHIRPSTACK_DB_USER=chirpstack
CHIRPSTACK_DB_PASSWORD=change-me
CHIRPSTACK_REDIS_DB=0
CHIRPSTACK_MQTT_USERNAME=chirpstack
CHIRPSTACK_MQTT_PASSWORD=change-me
# First admin account for the ChirpStack web UI.
CHIRPSTACK_ADMIN_EMAIL=admin@example.com
CHIRPSTACK_ADMIN_PASSWORD=change-me
# LoRaWAN region (Task 14). EU868 is the default for Mauritius / Indian Ocean.
CHIRPSTACK_REGION=eu868
