# Device management service environment (Symfony 8.1 + FrankenPHP).
#
# In the Docker stack these values come from the container environment
# (deploy/.env via docker-compose). Values set here are development defaults.
#
# Copy to services/device-mgmt/.env.local for local overrides — never commit
# real secrets.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=change-me
###< symfony/framework-bundle ###

# PostgreSQL connection to the platform `iiot` database.
DATABASE_URL=postgresql://iiot:change-me@db:5432/iiot

# Auth service endpoint for JWKS discovery (stateless JWT validation).
AUTH_JWKS_URL=http://auth:3000/auth/jwks
